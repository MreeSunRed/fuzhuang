# Copy this file to src/db.properties and fill in your local values.
# src/db.properties is ignored by git. Never commit real credentials.
#
# Environment variables DB_URL / DB_USER / DB_PASSWORD override these values.

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/fuzhuang?useUnicode=true&characterEncoding=utf8
db.user=root
db.password=your-password-here
